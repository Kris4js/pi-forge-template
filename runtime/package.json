{
  "name": "@pi-forge/runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "pi-sdk agent runtime. Speaks JSON-RPC over stdio to the pi-forge gateway.",
  "scripts": {
    "start": "tsx src/main.ts",
    "check": "tsc --noEmit",
    "migrate:storage": "tsx src/memory/migrate.ts",
    "test": "node --import tsx --test --test-timeout=60000 test/*.test.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.80.3",
    "@earendil-works/pi-ai": "0.80.3",
    "@earendil-works/pi-coding-agent": "0.80.3",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "tsx": "^4.19.3",
    "typebox": "1.1.38"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "typescript": "^5.7.3"
  }
}
