# Copy to .env and adjust as needed.
# process.env values still win over .env values.

# Optional server port
PORT=7171

# Custom provider example:
# Supported custom protocols:
# - openai-completions
# - anthropic-messages
MINIPI_MODEL_PROVIDER=custom
MINIPI_MODEL_PROTOCOL=openai-completions
MINIPI_MODEL_BASE_URL=http://localhost:8317/v1
MINIPI_MODEL_ID=minimax/minimax-m2.7
MINIPI_MODEL_THINKING_LEVEL=medium
MINIPI_MODEL_API_KEY=yourapikeyhere

# Common built-in provider API keys supported by pi model registry
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
