# Copy to .env. process env wins over .env. Both gateway and runtime read this file.

# ---- gateway (Go) ----
FORGE_ADDR=:8090
# JSON file mapping API keys to tenants. Unset + FORGE_DEV_AUTH=1 => anonymous dev access.
# FORGE_KEYS_FILE=config/keys.json
FORGE_DEV_AUTH=1
# Require X-User-Id when the key does not pin a user.
FORGE_REQUIRE_USER_ID=0
FORGE_MAX_CONCURRENT_RUNS=16
FORGE_MAX_RUNS_PER_WORKSPACE=4
FORGE_RUN_TIMEOUT_MS=300000
FORGE_APPROVAL_TIMEOUT_MS=120000
# Serve the built web app (npm run build) from the gateway.
# FORGE_WEB_DIR=web/dist

# ---- shared ----
FORGE_AGENTS_DIR=agents
FORGE_DATA_DIR=.data

# ---- runtime (TS / pi-sdk) ----
# A model is required; the runtime refuses to start without one.
# Custom OpenAI/Anthropic-compatible endpoint (shown in the UI by its bare model id):
PI_MODEL_PROVIDER=custom
# PI_MODEL_PROTOCOL: openai-completions | anthropic-messages
PI_MODEL_PROTOCOL=openai-completions
PI_MODEL_BASE_URL=https://openrouter.ai/api/v1
PI_MODEL_ID=deepseek/deepseek-chat
PI_MODEL_API_KEY=
# PI_MODEL_THINKING_LEVEL=medium
# PI_MODEL_CONTEXT_WINDOW=262144
# PI_MODEL_MAX_TOKENS=32768

# Or a pi built-in provider (shown as provider/model), keyed by its usual env var:
# PI_MODEL_PROVIDER=anthropic
# PI_MODEL_ID=claude-sonnet-5-5
# ANTHROPIC_API_KEY=
